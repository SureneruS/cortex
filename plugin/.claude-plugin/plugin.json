{
  "name": "cortex",
  "version": "0.3.10",
  "description": "Persistent context brain — session orchestration, PR operations, cron scheduling",
  "author": { "name": "Suren" },
  "skills": "./skills/",
  "agents": ["./agents/dream.md", "./agents/meditate.md"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cortex-hook-session-start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cortex-hook-user-prompt"
          }
        ]
      }
    ]
  }
}
